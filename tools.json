    {
      "name": "find_airports",
      "title": "Find airports and city codes",
      "description": "Find airports and city codes for your trip using Mubboo Flights. Search by place name or IATA code and choose the intended location when several suggestions match. Results identify locations; flight availability is checked separately.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "language": {
            "default": "en",
            "type": "string",
            "maxLength": 12,
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z]{2,8})?$"
          }
        },
        "required": [
          "query"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
