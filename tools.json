    {
      "name": "prepare_flight_search",
      "title": "Prepare a flight search link",
      "description": "Prepare a personalized Mubboo Flights search for one-way, round-trip or multi-city travel. Validate airports, dates, passengers, cabin, language and currency, then return a search link. The traveler opens the link to compare current options; this tool returns search details rather than quotes or reservations. Round trips require outbound and reversed inbound segments. comfort means premium economy. childAges must contain an age for every child; infants are on lap.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "market": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          },
          "language": {
            "type": "string",
            "maxLength": 12,
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z]{2,8})?$"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "tripType": {
            "type": "string",
            "enum": [
              "oneway",
              "roundtrip",
              "multicity"
            ]
          },
          "segments": {
            "minItems": 1,
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "origin": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                "destination": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              },
              "required": [
                "origin",
                "destination",
                "date"
              ],
              "additionalProperties": false
            }
          },
          "adults": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          },
          "children": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "infants": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "childAges": {
            "maxItems": 7,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 17
            }
          },
          "cabin": {
            "type": "string",
            "enum": [
              "economy",
              "comfort",
              "business",
              "first"
            ]
          }
        },
        "required": [
          "market",
          "language",
          "currency",
          "tripType",
          "segments",
          "adults",
          "children",
          "infants",
          "childAges",
          "cabin"
        ],
